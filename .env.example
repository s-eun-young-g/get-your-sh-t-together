# Copy to .env and edit. Every setting is optional.

# Where the database and secret live. Default: ~/.strata
# STRATA_DATA_DIR=~/.strata

# Set a password to require login. Recommended even at home, since the app
# listens on your whole wifi network. Required before deploying anywhere.
# STRATA_PASSWORD=

# Cookie signing secret. Auto-generated and persisted in the data dir if unset.
# STRATA_SECRET=

# Port to listen on. Default: 8020
# STRATA_PORT=8020

# Set to enable the "suggest with Claude" button in Learn.
# ANTHROPIC_API_KEY=

# Set to enable POST /api/capture, the inbox endpoint for Slack workflows,
# Granola/Zapier automations, iOS Shortcuts, or curl. Pick any long random string.
# STRATA_CAPTURE_TOKEN=

# Set both to enable the "sync from Canvas" button in Work > School.
# Base URL is your school's Canvas address; the token comes from
# Canvas > Account > Settings > New Access Token.
# CANVAS_BASE_URL=https://canvas.mit.edu
# CANVAS_TOKEN=
